---
layout: layouts/base.njk
title: Blog — Class with Nico
description: New posts on English learning, study skills, and admissions.
---
<ul class="postlist">
{%- for post in collections.post | reverse -%}
  <li>
    <a href="{{ post.url }}">{{ post.data.title }}</a>
    <div class="date">{{ post.date | readableDate }}</div>
    {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
  </li>
{%- endfor -%}
</ul>
