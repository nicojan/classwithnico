<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{{ title or site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.title }} RSS" href="/feed.xml">
  <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml">
  <style>
    body{font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif; line-height:1.6; margin:0; padding:0 1rem; max-width: 72ch; margin-inline:auto;}
    header, footer{padding:1rem 0;}
    nav a{margin-right:1rem; text-decoration:none;}
    .postlist{list-style:none; padding:0}
    .postlist li{margin:1.25rem 0; padding-bottom:.75rem; border-bottom:1px solid #eee}
    .date{opacity:.6; font-size:.9rem}
    pre, code{font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace}
  </style>
</head>
<body>
  <header>
    <nav>
      <a href="/">Blog Home</a>
      <a href="https://classwith.nicojan.com">Main Site</a>
      <a href="/admin/">Admin</a>
    </nav>
    <h1 style="font-weight:600; font-size:1.8rem; margin: .5rem 0">{{ title or site.title }}</h1>
    {% if description %}<p>{{ description }}</p>{% endif %}
  </header>
  <main>
    {{ content | safe }}
  </main>
  <footer>
    <p>© {{ (new Date()).getFullYear() }} {{ site.author.name }} • <a href="/feed.xml">RSS</a> • <a href="/sitemap.xml">Sitemap</a></p>
  </footer>
</body>
</html>
